{
    "name": "oxodao/qne-oauth-bundle",
    "description": "A Quick And Easy OAuth2 opiniated client bundle",
    "version": "0.1.0",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Oxodao\\QneOAuthBundle\\": "src/"
        }
    },
    "authors": [
        {
            "name": "oxodao"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-xml": "*",
        "symfony/framework-bundle": "^7.3",
        "symfony/serializer": "^7.3",
        "symfony/http-client": "^7.3",
        "doctrine/orm": "^3.5",
        "doctrine/doctrine-bundle": "^2.16|^3.0",
        "symfony/security-bundle": "^7.3",
        "lexik/jwt-authentication-bundle": "^3.1",
        "lcobucci/jwt": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "^2.1",
        "ticketswap/phpstan-error-formatter": "^1.2",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
